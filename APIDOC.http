# list
###
GET http://127.0.0.1:8000/doctors/
Accept: application/json

# add
###
POST http://127.0.0.1:8000/doctors/
Content-Type: application/json

{
    "name":"Arun Kumar",
    "specialization":"surgeon",
    "fee":300,
    "qualification":"mbbs,ms(general surgery)",
    "email":"arun@gmail.com"
}

#retrieve
###
GET http://127.0.0.1:8000/doctors/1/
Accept: application/json

#update
###
PUT http://127.0.0.1:8000/doctors/1/
Content-Type: application/json

{
    "qualification":"mbbs,ms,mch"
}

#delete
###
DELETE http://127.0.0.1:8000/doctors/1/
Accept: application/json

#V2 end points

# list
###
GET http://127.0.0.1:8000/v2/doctors/
Accept: application/json
Authorization: Basic admin_user:adminuser@123

#create
###
POST http://127.0.0.1:8000/v2/doctors/
Content-Type: application/json
Authorization: Basic admin_user:adminuser@123

{
    "id":2,
    "name":"Anaswara gupta",
    "specialization":"endocrinology",
    "fee":300,
    "qualification":"mbbs,ms(general surgery)",
    "email":"anaswara@gmail.com"
} 

#retrieve
###
GET http://127.0.0.1:8000/v2/doctors/2/
Accept: application/json

#update
###
PUT http://127.0.0.1:8000/doctors/7/
Content-Type: application/json

{
    "id":1,
    "name":"venkat chithambaram",
    "specialization":"gastroenterology",
    "fee":300,
    "qualification":"mbbs,ms(general surgery)",
    "email":"venkatmbbs@gmail.com"
} 

#delete
###
DELETE http://127.0.0.1:8000/doctors/2/
Accept: application/json

#API call for creating Admin User
###
POST http://127.0.0.1:8000/v2/admin-register/
Content-Type: application/json

{
    "username":"admin_user",
    "email":"adminuser@gmail.com",
    "password":"adminuser@123"
}

